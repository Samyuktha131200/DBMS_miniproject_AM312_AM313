{
  "name": "hospital-er-mongodb",
  "version": "1.0.0",
  "private": true,
  "description": "MongoDB component of the Hospital Emergency Management System: incident reports, observation logs and clinical notes",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "seed": "node scripts/seed.js",
    "roles": "node scripts/create-roles.js",
    "db:init": "node scripts/setup.js && node scripts/seed.js --reset",
    "queries": "node scripts/run-queries.js",
    "export:mongosh": "node scripts/export-mongosh.js",
    "docs:queries": "node scripts/generate-query-docs.js",
    "test": "node --test"
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "main": "lib/repository.js"
}
