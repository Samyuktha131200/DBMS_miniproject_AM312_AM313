# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real credentials.

# Local MongoDB (no authentication):
MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas example (replace the placeholders, keep the quotes off):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name (optional, this is the default)
MONGODB_DB=hospital_emergency_management

# ---- Optional: database users for role-based access (npm run roles -- --users)
# Only users whose password is set here are created. Use 12+ characters.
# MONGODB_APP_PASSWORD=
# MONGODB_DOCTOR_PASSWORD=
# MONGODB_NURSE_PASSWORD=
# MONGODB_ADMIN_PASSWORD=

# ---- Tests: a server the integration tests may create throw-away databases on
# MONGODB_TEST_URI=mongodb://localhost:27017
