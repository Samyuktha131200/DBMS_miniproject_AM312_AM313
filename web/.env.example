# Copy to .env.local (PowerShell: Copy-Item .env.example .env.local) and fill in.
# .env.local is git-ignored; never commit real passwords or secrets.

# ---- MySQL (run 01-05 *.sql in MySQL Workbench first)
MYSQL_HOST=localhost
MYSQL_PORT=3306
# root works for local development. After running 05_security.sql you can
# create er_app_user (see the end of that file) and use it here instead.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hospital_emergency_management

# ---- MongoDB (run npm run setup && npm run seed in ../mongodb first)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hospital_emergency_management

# ---- Login sessions: a random value of at least 32 characters. Generate one with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
